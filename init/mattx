MATTX_KVER=$(uname -r)
MATTX_MOD_PATH="/usr/local/lib/modules/$MATTX_KVER/mattx.ko"
MATTXFS_MOD_PATH="/usr/local/lib/modules/$MATTX_KVER/mattxfs.ko"
MATTX_CONF_PATH="/etc/mattx.conf"
MATTX_DAEMON_PATH="/usr/local/sbin/mattx-discd"
MATTX_PROC_ADMIN="/proc/mattx/admin"
MATTX_PROC_GUESTS="/proc/mattx/guests"

check_files() {
    if [ ! -f "$MATTX_MOD_PATH" ]; then
        echo "MattX [ERROR]: Kernel module not found at $MATTX_MOD_PATH"
        exit 1
    fi
    if [ ! -f "$MATTXFS_MOD_PATH" ]; then
        echo "MattX [ERROR]: MattXFS kernel module not found at $MATTXFS_MOD_PATH"
        exit 1
    fi
    if [ ! -f "$MATTX_CONF_PATH" ]; then
        echo "MattX [ERROR]: Configuration file not found at $MATTX_CONF_PATH"
        exit 1
    fi
    if [ ! -x "$MATTX_DAEMON_PATH" ]; then
        echo "MattX [ERROR]: Discovery daemon not found or not executable at $MATTX_DAEMON_PATH"
        exit 1
    fi
}

start() {
    echo "Starting MattX SSI Cluster..."
    check_files
    . $MATTX_CONF_PATH

    # 1. Load the Kernel Module
    if lsmod | grep -q "^mattx "; then
        echo "MattX [INFO]: Kernel module is already loaded."
    else
        echo "MattX [INFO]: Loading kernel module ($MATTX_MOD_PATH)..."
        insmod "$MATTX_MOD_PATH"
        if [ $? -ne 0 ]; then
            echo "MattX [FATAL]: Failed to load kernel module!"
            exit 1
        fi
    fi

    # 2. Start the Discovery Daemon
    if pgrep -x "mattx-discd" > /dev/null; then
        echo "MattX [INFO]: Discovery daemon is already running."
        DAEMON_PID=$(pgrep -x "mattx-discd")
    else
        echo "MattX [INFO]: Starting discovery daemon..."
        # Run in background and redirect output to a log file
        $MATTX_DAEMON_PATH > /var/log/mattx-discd.log 2>&1 &
        DAEMON_PID=$!
        sleep 1
        if ! pgrep -x "mattx-discd" > /dev/null; then
            echo "MattX [FATAL]: Discovery daemon failed to start!"
            exit 1
        fi
    fi

    # 3. Mount the MattXFS if enabled
    if [ "$MATTXFS_ENABLED" = true ]; then

        # Load MattXFS Kernel Module
        if lsmod | grep -q "^mattxfs "; then
            echo "MattX [INFO]: MattXFS kernel module is already loaded."
        else
            echo "MattX [INFO]: Loading MattXFS kernel module..."
            insmod "$MATTXFS_MOD_PATH"
            if [ $? -ne 0 ]; then
                echo "MattX [FATAL]: Failed to load kernel module!"
                exit 1
            fi
        fi

        mkdir -p /mattxfs
        echo "MattX [INFO]: Mounting MattXFS at /mattxfs..."
        mkdir -p /mattxfs
        mount -t mattxfs none /mattxfs
        if [ $? -ne 0 ]; then
            echo "MattX [FATAL]: Failed to mount MattXFS!"
            exit 1
        fi
    else
        echo "MattX [INFO]: MattXFS is disabled in configuration."
    fi

    # 4. setup DFSA directory if enabled
    if [ "$DFSA_DIR" != "" ]; then
        mkdir -p "$DFSA_DIR"
        chmod 777 "$DFSA_DIR"
        echo "MattX [INFO]: Direct File System Access (DFSA) directory set to $DFSA_DIR"
    else
        echo "MattX [INFO]: DFSA directory not specified in configuration."
    fi 

    # 5. set default includes for the cluster
    if [ -n "$MATTX_INCLUDE" ]; then
        echo "MattX [INFO]: Setting default included processes: $MATTX_INCLUDE"
        echo "include $MATTX_INCLUDE" > $MATTX_PROC_ADMIN
    else
        echo "MattX [WARNING]: No default included processes specified in configuration."
    fi

    # 6. set the processes that must never migrate (wins over MATTX_INCLUDE)
    if [ -n "$MATTX_EXCLUDE" ]; then
        echo "MattX [INFO]: Setting never-migrate processes: $MATTX_EXCLUDE"
        echo "exclude $MATTX_EXCLUDE" > $MATTX_PROC_ADMIN
    else
        echo "MattX [INFO]: No MATTX_EXCLUDE in configuration, keeping the built-in exclude list."
    fi

    echo $DAEMON_PID > /var/run/mattx.pid

    echo "MattX started successfully! 🚀"
}

stop() {
    echo "Stopping MattX SSI Cluster..."
    
    # 1. Cordon and Drain (High Availability Shutdown)
    if [ -f "$MATTX_PROC_ADMIN" ] && [ -f "$MATTX_PROC_GUESTS" ]; then
        echo "MattX [INFO]: Cordoning node (Disabling incoming migrations)..."
        echo "accept 0" > "$MATTX_PROC_ADMIN"

        GUEST_COUNT=$(wc -l < "$MATTX_PROC_GUESTS")
        if [ "$GUEST_COUNT" -gt 0 ]; then
            echo "MattX [INFO]: Draining node... Expelling $GUEST_COUNT guest process(es)..."
            
            # Loop through all guests and expel them one by one
            for pid in $(cut -d':' -f1 "$MATTX_PROC_GUESTS"); do
                echo "MattX [INFO]: Expelling PID $pid back to its Home Node..."
                # This echo blocks until the kernel finishes the return migration!
                echo "expel $pid" > "$MATTX_PROC_ADMIN"
            done
            echo "MattX [INFO]: All guests successfully expelled and safely home."
        else
            echo "MattX [INFO]: No guest processes to expel."
        fi
    fi

    # 2. Unmount the MattXFS if it was mounted
    if mountpoint -q /mattxfs; then
        echo "MattX [INFO]: Unmounting MattXFS..."
        umount /mattxfs
        if [ $? -ne 0 ]; then
            echo "MattX [FATAL]: Failed to unmount MattXFS! Are there still open files or processes using it?"
            exit 1
        fi
    fi

    # 3. Stop the Discovery Daemon
    if pgrep -x "mattx-discd" > /dev/null; then
        echo "MattX [INFO]: Stopping discovery daemon..."
        pkill -x "mattx-discd"
        sleep 1
    fi

    # 4. Unload the Kernel Module
    if lsmod | grep -q "^mattx "; then
        echo "MattX [INFO]: Unloading kernel module..."
        rmmod mattx
        if [ $? -ne 0 ]; then
            echo "MattX [FATAL]: Failed to unload kernel module! Are there still exported processes?"
            exit 1
        fi
    fi
    rm -f /var/run/mattx.pid

    echo "MattX stopped successfully! 🛑"
}

status() {
    echo "--- MattX Cluster Status ---"
    if lsmod | grep -q "^mattx "; then
        echo "Kernel Module:   LOADED"
        if [ -f "$MATTX_PROC_GUESTS" ]; then
            GUESTS=$(wc -l < "$MATTX_PROC_GUESTS")
            echo "Active Guests:   $GUESTS"
        fi
    else
        echo "Kernel Module:   NOT LOADED"
    fi

    if pgrep -x "mattx-discd" > /dev/null; then
        echo "Daemon (discd):  RUNNING"
    else
        echo "Daemon (discd):  STOPPED"
    fi
    echo "----------------------------"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        sleep 2
        start
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
esac
exit 0
